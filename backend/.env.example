# MongoDB connection string (MongoDB Atlas recommended for cloud hosting)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shaneeq?retryWrites=true&w=majority

# Port the server runs on (Glitch/Render/Railway will usually inject their own)
PORT=5000

# JWT secret used to sign admin login tokens - change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret_key

# Comma separated list of allowed frontend origins (Vercel domain, localhost, etc.)
CLIENT_ORIGINS=http://localhost:5500,https://shaneeq.vercel.app

# Default admin credentials used by the one-time seed script (backend/seed.js)
ADMIN_EMAIL=admin@shaneeq.com
ADMIN_PASSWORD=ChangeMe123!
